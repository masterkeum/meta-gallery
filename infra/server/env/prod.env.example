# =============================================================================
# meta-gallery 운영계(prod) 환경변수 — 예시 파일
#   실제 파일 : /etc/meta-gallery/prod.env   (0600 root:root)
#   읽는 주체 : systemd  meta-gallery-api@prod.service  (EnvironmentFile)
#
# !! 이 예시 파일은 저장소에 커밋된다. 실제 값을 절대 여기에 쓰지 않는다.
#    __REPLACE_...__ 는 모두 자리표시자다. provision.sh가 서버에서 난수 비밀번호를
#    생성해 /etc/meta-gallery/prod.env 를 채운다(저장소로 되돌려 커밋하지 않는다).
#
# 형식 주의 : systemd EnvironmentFile 은 셸이 아니다.
#    - KEY=VALUE 한 줄씩, export 금지, 값 안의 $ 는 $$ 로 escape
#    - 값에 공백·특수문자가 있으면 "..." 로 감싼다
# =============================================================================

NODE_ENV=production
APP_ENV=prod

# nginx가 127.0.0.1:3000 으로 프록시한다(계획서 1-2). 외부 바인딩 금지.
HOST=127.0.0.1
PORT=3000

# PostgreSQL 16 (같은 인스턴스, 루프백 전용).
# 비밀번호는 URL에 들어가므로 provision.sh가 영숫자만으로 생성한다(퍼센트 인코딩 불필요).
# sslmode=disable 은 루프백 구간이라 TLS를 쓰지 않는다는 뜻이다
# → 이 선택의 적정성은 정보보호본부 애플리케이션보안팀 검토 대상(계획서 3-2).
DATABASE_URL=postgresql://mg_prod:__REPLACE_WITH_GENERATED_PASSWORD__@127.0.0.1:5432/metagallery_prod?sslmode=disable

# 공개 주소 (DuckDNS, 계획서 1-3)
PUBLIC_BASE_URL=https://metagallery.duckdns.org

# S3 버킷 이름 (비밀값 아님. 계획서 1-4)
# 버킷 이름이 전역 선점돼 변경되면 Terraform 출력값과 함께 이 값도 갱신한다.
ASSETS_BUCKET=<ASSETS_BUCKET_PROD>
AWS_REGION=ap-southeast-2

LOG_LEVEL=info

# 세션·토큰 서명 키 등 백엔드가 쓸 비밀값은 백엔드팀이 필요한 키 이름을 확정한 뒤
# 같은 방식(서버에서 생성 → 0600 파일)으로 추가한다. 예시만 남겨 둔다.
# SESSION_SECRET=__REPLACE_WITH_GENERATED_SECRET__
