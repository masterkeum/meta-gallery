# =============================================================================
# meta-gallery API 서버 (템플릿 유닛)
#   설치 위치 : /etc/systemd/system/meta-gallery-api@.service
#   인스턴스  : meta-gallery-api@prod.service / meta-gallery-api@dev.service
#   %i = prod | dev
#
# !! 지금은 백엔드 코드가 없다. provision.sh는 이 유닛을 "설치만" 하고
#    enable/start 하지 않는다. ExecStart는 자리표시자이며, 백엔드팀이 런타임과
#    기동 명령을 확정하면 아래 TODO 줄을 교체한 뒤 enable 한다.
#    (계획서 1-2, 3-1 / docs/infra/server-layout.md "백엔드 유닛 활성화 절차")
# =============================================================================
[Unit]
Description=meta-gallery API server (%i)
Documentation=file:///srv/meta-gallery/%i/current
After=network-online.target postgresql.service
Wants=network-online.target
# PostgreSQL이 같은 인스턴스에 있으므로 기동 순서만 맞춘다(Requires로 묶지 않는다:
# DB 재시작이 API를 강제 종료하지 않게).

[Service]
Type=simple
User=deploy
Group=mgweb
WorkingDirectory=/srv/meta-gallery/%i/current

# DB 접속정보 등은 0600 root:root 파일에서만 읽는다. systemd가 권한을 내리기 전
# root로 읽으므로 deploy 계정에 읽기 권한을 주지 않아도 동작한다.
EnvironmentFile=/etc/meta-gallery/%i.env

# ---------------------------------------------------------------------------
# TODO(IT본부 백엔드팀): 런타임·기동 명령 확정 후 아래 ExecStart 한 줄을 교체한다.
#   예) ExecStart=/usr/bin/node /srv/meta-gallery/%i/current/server/index.js
#   확인 필요: Node 버전, 엔트리포인트 경로, 포트를 PORT 환경변수로 받는지,
#             헬스체크 엔드포인트 경로(/api/healthz 예정)
# 현재는 실수로 start 되더라도 즉시 실패하도록 EX_CONFIG(78)로 종료한다.
# ---------------------------------------------------------------------------
ExecStart=/bin/sh -c 'echo "meta-gallery-api@%i: ExecStart is not configured yet (backend code pending)" >&2; exit 78'

Restart=on-failure
RestartSec=5s
# 자리표시자 상태에서 무한 재시작 루프를 돌지 않게 제한한다.
StartLimitIntervalSec=120
StartLimitBurst=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=meta-gallery-api-%i

# --- 리소스 제한 (1GB RAM 인스턴스. PostgreSQL + prod/dev 2개 동시 구동 대비) ---
MemoryMax=256M
MemoryHigh=192M
TasksMax=128

# --- 샌드박스 (정보보호본부 애플리케이션보안팀 검토 대상) ---
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# 쓰기 가능 경로는 환경별 shared 디렉터리만 허용한다.
ReadWritePaths=/srv/meta-gallery/%i/shared
# 루프백 바인딩만 하므로 UNIX/IPv4/IPv6로 제한한다.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
