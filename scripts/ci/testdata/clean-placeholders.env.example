# 회귀 테스트 표본 — 탐지되면 안 되는(오탐) 줄 모음
# 팀원 2·3·4 가 실제로 쓰는 자리표시자 관행과 설정값을 그대로 담았다.
# [[DETECT]] 마커가 하나도 없다 → 검사기는 이 파일에서 0건을 보고해야 한다.

# --- 자리표시자 관행 (infra/server/env/*.env.example, terraform.tfvars.example) ---
DATABASE_URL=postgresql://mg_prod:__REPLACE_WITH_GENERATED_PASSWORD__@127.0.0.1:5432/metagallery_prod?sslmode=disable
ADMIN_PASSWORD=__REPLACE_WITH_GENERATED_PASSWORD__
DUCKDNS_TOKEN=<DUCKDNS_TOKEN>
API_TOKEN=${API_TOKEN}
SESSION_SECRET=CHANGE_ME
BASIC_AUTH_PASSWORD=TODO
ssh_allowed_cidrs = ["<CEO_PUBLIC_IP>/32"]
ssh_key_pair_name = "<LIGHTSAIL_KEY_PAIR_NAME>"

# --- 비밀값이 아닌 설정값·경로 (infra/server/) ---
HTPASSWD_FILE="/etc/nginx/.htpasswd-meta-gallery-dev"
auth_basic_user_file /etc/nginx/.htpasswd-meta-gallery-dev;
TOKEN_FILE=/etc/meta-gallery/duckdns.env
PASSWORD_ENCRYPTION_NOTE=/var/lib/postgresql/16/main

# --- 인증 방식 설정 (postgresql.conf / sudoers) ---
password_encryption = 'scram-sha-256'
deploy ALL=(root) NOPASSWD: MG_NGINX

# --- 비밀이 아닌 주소 (루프백·사설·문서용 RFC 5737) ---
HOST=127.0.0.1
LISTEN_ADDR=0.0.0.0
PRIVATE_SUBNET=10.0.1.25
DOC_EXAMPLE_IP=203.0.113.4

# --- GitHub Actions 식 참조 ---
DEPLOY_TOKEN_REF=${{ secrets.DUCKDNS_TOKEN }}
