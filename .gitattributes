# 메타 갤러리 저장소 속성
# 주관: IT본부 인프라팀 (docs/plans/2026-11-13-aws-infra.md 2장 항목 1)

# 기본: 텍스트 파일은 저장소에 LF로 저장한다.
* text=auto eol=lf

# ---------- 줄바꿈을 반드시 LF로 둬야 하는 파일 ----------
# 셸 스크립트와 서버 설정은 CRLF가 섞이면 Lightsail(Ubuntu)에서 실행이 깨진다.
*.sh        text eol=lf
*.bash      text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.sql       text eol=lf
*.tf        text eol=lf
*.tfvars    text eol=lf
*.hcl       text eol=lf
*.env.example text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
Dockerfile  text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# logrotate 설정처럼 확장자가 없는 파일
infra/server/logrotate/* text eol=lf

# ---------- 바이너리 (diff·줄바꿈 변환 금지) ----------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.zip   binary
*.gz    binary
*.mp3   binary
*.mp4   binary
*.glb   binary
*.gltf  binary

# ---------- GitHub 언어 통계 보정 ----------
docs/**      linguist-documentation
.github/**   linguist-generated=false
